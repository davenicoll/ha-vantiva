#!/usr/bin/env bash
# Local secrets gate before anything leaves the machine: whole tree + full history.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/check_secrets.py"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --redact --no-banner "$root"
else
  echo "pre-push: gitleaks not installed (brew install gitleaks); only the repo-specific check ran" >&2
fi
